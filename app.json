
{
  "expo": {
    "name": "المصحف الشريف",
    "slug": "mushaf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mushaf",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a06ed7ab-9c05-41a7-9833-492a0821f2dd",
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012234",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.mohamedsaeed7.mushaf"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#012234",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#012234",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 170,
            "resizeMode": "contain"
          },
          "dark": {
            "backgroundColor": "#012234",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لت      سجيل ملاحظاتك الصوتية على كلمات المصحف.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "updateNotes": [
        "نتائج بحث جديدة متناسقة مع شريط البحث، تظهر أسفل الشريط مباشرة.",
        "شريط تنقل محدّث في المصحف بعرض أوضح لاسم السورة ورقم الصفحة والجزء.",
        "تصميم جديد لإعدادات التلاوة وزر التسميع، مع صور لعدد أكبر من القرّاء.",
        "يمكنك الآن استخدام وضع التسميع دون اتصال بالإنترنت.",
        "شاشة بداية محدّثة بمظهر أكثر أناقة."
      ],
      "eas": {
        "projectId": "a06ed7ab-9c05-41a7-9833-492a0821f2dd"
      }
    }
  }
}
