
{
  "expo": {
    "name": "المصحف الشريف",
    "slug": "mushaf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mushaf",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a06ed7ab-9c05-41a7-9833-492a0821f2dd",
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012234",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.mohamedsaeed7.mushaf"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#012234",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#012234",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 170,
            "resizeMode": "contain"
          },
          "dark": {
            "backgroundColor": "#012234",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لت      سجيل ملاحظاتك الصوتية على كلمات المصحف.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "updateNotes": [
        "تلاوة متزامنة كلمة بكلمة: تتحدد الكلمة التي يقرأها الشيخ تلقائياً على الصفحة، مع انتقال سلس بين الكلمات والآيات.",
        "مظهر أوضح وأكثر نعومة لتمييز الآية والكلمة الجارية أثناء التلاوة.",
        "يتوقف المشغل ويختفي تلقائياً بعد انتهاء الآيات المحددة بدلاً من أن يبقى ثابتاً بلا تشغيل.",
        "تقليب أسرع لصفحات المصحف، واستجابة أسرع للبحث والكتابة والتمرير في القوائم."
      ],
      "eas": {
        "projectId": "a06ed7ab-9c05-41a7-9833-492a0821f2dd"
      }
    }
  }
}
