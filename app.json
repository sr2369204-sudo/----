{
  "expo": {
    "name": "المصحف الشريف",
    "slug": "mushaf",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mushaf",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a06ed7ab-9c05-41a7-9833-492a0821f2dd",
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012234",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "package": "com.mohamedsaeed7.mushaf"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#012234",
          "android": {
            "backgroundColor": "#012234"
          },
          "dark": {
            "backgroundColor": "#012234"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لتسجيل ملاحظاتك الصوتية على كلمات المصحف.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "updateNotes": [
        "أذكار حصن المسلم: ١٤٢ ذكرًا في ١٠ مجموعات داخل قسم الأذكار.",
        "قائمة القراء تفتح على القارئ الذي اخترته.",
        "التشغيل من هنا يعمل بدون إنترنت إذا كانت الصفحة محمّلة، ورسالة أوضح عند انقطاع الإنترنت.",
        "التفسير بشكل جديد: صفحات تتقلب بالضغط أو السحب، ويعمل بدون إنترنت، ومتاح لأكثر من آية.",
        "معنى الكلمة في ورقة صغيرة، ومعنى لكل كلمة في القرآن من مركز تفسير للدراسات القرآنية، وتتنقل بين الكلمات باللمس.",
        "إصلاح المشغل: ضغطة واحدة تخفي المشغل وشريط الأزرار معًا، والضغط المطوّل ما يظهر الشريط.",
        "تتبع الآية أثناء التلاوة مع 20 قارئًا جديدًا وياسر الدوسري وإبراهيم الدوسري وبندر بليلة."
      ],
      "eas": {
        "projectId": "a06ed7ab-9c05-41a7-9833-492a0821f2dd"
      }
    }
  }
}