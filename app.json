{
  "expo": {
    "name": "المصحف الشريف",
    "slug": "mushaf",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mushaf",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a06ed7ab-9c05-41a7-9833-492a0821f2dd",
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#012234",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.mohamedsaeed7.mushaf"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#012234",
          "image": "./assets/images/splash-screen.png",
          "resizeMode": "cover",
          "android": {
            "backgroundColor": "#012234",
            "image": "./assets/images/splash-screen.png",
            "resizeMode": "cover"
          },
          "dark": {
            "backgroundColor": "#012234",
            "image": "./assets/images/splash-screen.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لتسجيل ملاحظاتك الصوتية على كلمات المصحف.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "updateNotes": [
        "نافذتا التفسير ومعنى الكلمة: عرض الآية في البداية مع أزرار السابق والتالي ونسخ النص.",
        "تمييز الآيات المحدَّدة بإطار واضح مشابه لتمييز القارئ.",
        "خلفية مشغل التلاوة أصبحت معتمة، ولمس الصفحة يخفي المشغل ويعيد إظهاره.",
        "تحسين شكل مشغل التلاوة وترتيب أدواته، وشريط التقدّم يبدأ من اليمين ويبقى داخل الشاشة.",
        "إضافة تكرار الآية بعدد مستقل عن تكرار المقطع المحدَّد.",
        "الصفحة الرئيسية: بطاقتا «قلب القرآن» و«التسجيلات» جنبًا إلى جنب مع مؤشر دائري لنسبة الحفظ.",
        "إضافة صور القرّاء في قوائم اختيار القارئ مع بديل بالأحرف عند غياب الصورة."
      ],
      "eas": {
        "projectId": "a06ed7ab-9c05-41a7-9833-492a0821f2dd"
      }
    }
  }
}